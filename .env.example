OPENCODE_API=sua-key-do-opencode-go-aqui
# Opcional — padrão: muse-spark-1.3-contributor
# OPENCODE_MODEL=muse-spark-1.3-contributor

# Transcrição de vídeos via API da OpenAI (whisper-1). Sem ela, vídeos usam só metadados.
OPENAI_API_KEY=sua-key-da-openai-aqui
# Opcional — padrão: whisper-1
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Worker de mídia (Fly.io) — só necessário onde não há yt-dlp (Vercel).
# Local com yt-dlp instalado ignora estas vars.
# MEDIA_WORKER_URL=https://iev-media-worker.fly.dev
# MEDIA_WORKER_SECRET=segredo-igual-ao-fly-secrets
