OPENCODE_API=sua-key-do-opencode-go-aqui
# Opcional — padrão: muse-spark-1.3-contributor
# OPENCODE_MODEL=muse-spark-1.3-contributor

# Transcrição de áudio/vídeo via API da OpenAI (whisper-1); sem a chave a transcrição fica indisponível.
OPENAI_API_KEY=sua-key-da-openai-aqui
# Opcional — padrão: whisper-1
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Worker remoto de mídia. Obrigatório em serverless/Vercel; desenvolvimento sem worker
# usa ffprobe/ffmpeg locais. Quando configurado, falha do worker não cai em processamento local.
# MEDIA_WORKER_URL=https://iev-media-worker.fly.dev
# MEDIA_WORKER_SECRET=segredo-igual-ao-fly-secrets
# O worker recusa iniciar sem WORKER_SECRET (use WORKER_ALLOW_INSECURE=1 apenas em dev).
# WORKER_EGRESS_PROXY=http://proxy-de-saida:8080   # opcional: bloqueio de rede interna no worker
# IEV_MEDIA_PRESENCE_TIMEOUT_MS=30000  # teto do probe de presença de mídia em posts sociais

# Painel administrativo (Bearer). Sem ADMIN_SECRET, /api/admin responde 503.
# Exige 32+ caracteres aleatórios: abaixo disso responde 503 admin_secret_too_weak.
# Gere com: openssl rand -hex 32   (64 caracteres) ou um UUID v4.
# ADMIN_SECRET=00000000-0000-4000-8000-000000000000

# Supabase configurado tem prioridade para todo o estado privado (migração
# 202610160001_private_state.sql). Blob é usado apenas sem Supabase.
# Blob privado: cache, recuperação da entrega, correções e configuração de IA.
# Também armazena logs quando a Supabase não está configurada.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Supabase: checagens persistidas, logs privados e publicação explícita por ID.
# A URL existente NEXT_PUBLIC_SUPABASE_URL é aceita; não precisa de prefixo VITE_.
# A ANON_KEY não autoriza operações privadas e não é utilizada pelo servidor.
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publica-do-projeto
# SUPABASE_URL=https://seu-projeto.supabase.co  # alternativa; tem prioridade sobre NEXT_PUBLIC_
# SUPABASE_SERVICE_ROLE_KEY=chave-privada-somente-no-servidor
# Aplique primeiro a migração em supabase/migrations no SQL Editor da Supabase.
# Nunca use NEXT_PUBLIC_ ou VITE_ na chave service-role; nunca a envie ao navegador.

# ---------------------------------------------------------------------------
# Limites de entrada (valores padrão entre parênteses)
# ---------------------------------------------------------------------------
# IEV_MAX_UPLOAD_BYTES=3145728        # upload direto (3 MiB)
# IEV_MAX_TEXT_CHARS=8000             # texto aceito; acima disso é recusado
# IEV_MAX_MEDIA_SECONDS=900           # duração máxima processada (15 min)
# IEV_MAX_DOWNLOAD_BYTES=67108864     # teto de transferência por checagem (64 MiB)
# IEV_MAX_MEDIA_FILE_BYTES=33554432   # teto por arquivo de mídia (32 MiB)
# IEV_MAX_TEMP_BYTES=134217728        # vigia de disco do subprocesso (128 MiB)
# IEV_EVIDENCE_FETCH=0               # padrão: sem coleta documental independente; 1 ativa auditoria opcional
# IEV_MAX_DOC_BYTES=8388608           # teto por documento de evidência (8 MiB)
# IEV_EVIDENCE_MAX_DOCS=6             # documentos obtidos por checagem
# IEV_EVIDENCE_MAX_TOTAL_BYTES=25165824
# IEV_EVIDENCE_REVIEW=1              # revisão opcional somente com coleta ativada (0 desliga)
# IEV_EVIDENCE_REVIEW_PROVIDER=jev    # jev (padrão, usa OPENCODE_API) | judge (modelo judge configurado)
# IEV_EVIDENCE_REVIEW_MODEL=jev-1.13-free # modelo JEV; não há fallback automático para judge
# IEV_EVIDENCE_REVIEW_TIMEOUT_MS=20000   # prazo da revisão JEV em milissegundos
# JEV classifica a relação entre o trecho e a alegação integral; não estima a probabilidade de verdade.
# Relações com classe máxima < 0,7 ou margem < 0,2 são inconclusivas; pesquisa primária válida pode ser preservada.
# IEV_HTTP_PORTS=80,443               # portas permitidas na política de URL

# ---------------------------------------------------------------------------
# Política de rede (SSRF)
# ---------------------------------------------------------------------------
# IEV_ALLOW_PRIVATE_HOSTS=0           # 1 permite destinos privados (SOMENTE dev local)
# IEV_ALLOW_PRIVATE_WORKER=0          # 1 permite worker em endereço privado (dev)

# ---------------------------------------------------------------------------
# Controles de abuso e custo (server/limits.js)
# ---------------------------------------------------------------------------
# IEV_LIMITS_MODE=auto                # auto | shared | memory | off
#                                     # auto: usa o store REST se configurado; sem ele,
#                                     # memória em dev e RECUSA em produção (fail-closed)
#                                     # off: desliga os controles — em produção o endpoint
#                                     # recusa novas checagens (chave de interrupção
#                                     # operacional; páginas de transparência/correção
#                                     # continuam funcionando)
# UPSTASH_REDIS_REST_URL=             # armazenamento compartilhado (Upstash/Vercel KV)
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=                    # alternativa aceita
# KV_REST_API_TOKEN=
# IEV_RATE_LIMIT_PER_WINDOW=20        # checagens por origem na janela
# IEV_RATE_WINDOW_SECONDS=600
# IEV_MAX_CONCURRENT_CHECKS=3         # vagas simultâneas globais
# IEV_SLOT_LEASE_SECONDS=300          # lease da vaga (queda do processo libera)
# IEV_SLOT_WAIT_MS=20000              # espera por vaga antes de responder 429
# IEV_DAILY_CHECK_UNITS=200           # orçamento diário em unidades
# IEV_COST_UNITS={"text":1,"link":2,"image":2,"video":4}
# IEV_DAILY_TOKENS=0                  # teto diário de tokens observados (0 desliga)
# IEV_TOKENS_PER_UNIT=150000          # conciliação: cada N tokens observados consome 1 unidade
# IEV_CORRECTIONS_RATE_LIMIT_PER_WINDOW=5
# IEV_TRUST_PROXY=1                   # 0 ignora cabeçalhos de IP do proxy
# IEV_TRUST_PROXY_HEADER=x-forwarded-for

# ---------------------------------------------------------------------------
# Moderação de conteúdo e propósito (server/moderation.js)
# ---------------------------------------------------------------------------
# MODERATION_MODE=optional            # required | optional | off (produção usa required)
# MODERATION_MODEL=omni-moderation-latest
# MODERATION_REFUSE_CATEGORIES=sexual/minors,sexual
# MODERATION_THRESHOLDS={"sexual":0.7}
# MODERATION_FRAME_SAMPLES=4          # frames amostrados na triagem de vídeo
# MEDIA_VIDEO_MODERATION=partial_frames_transcript
#   # Em produção, sem esta declaração o processamento de vídeo é recusado
#   # (cobertura de moderação de vídeo precisa de decisão explícita do produto).

# ---------------------------------------------------------------------------
# Alertas operacionais (server/metrics.js)
# ---------------------------------------------------------------------------
# IEV_ALERT_AVG_LATENCY_MS=180000
# IEV_ALERT_ERROR_RATE=0.25
# IEV_ALERT_ABSTENTION_RATE=0.6
# IEV_ALERT_BUDGET_PCT=0.8
# IEV_ALERT_MIN_SAMPLE=10


# Audiência própria no Supabase (migração link_audience_tracking).
# IEV_AUDIENCE_ENABLED=1             # 0 desativa a coleta sem afetar o site
# IEV_ANALYTICS_SECRET=              # opcional: HMAC próprio; usa ADMIN_SECRET na ausência
# Localização: cabeçalhos confiáveis da Vercel, sem gravar IP/GPS.
